{
  "Logging": {
    "LogLevel": {
      // 발생하는 Log중 Information 단계 이상은 기록하겠다는 뜻
      "Default": "Information",
      // 서버인 Microsoft.AspNetCore에서 발생하는 로그는 Waring 이상만 기록하겠다는 뜻
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    // 실제 서명 키는 여기에 커밋하지 않습니다.
    // 로컬 개발: `dotnet user-secrets set "Jwt:Key" "값"` / 운영 배포: 환경변수 Jwt__Key
    "Key": "",
    "Issuer": "ChatMessenger_Server",
    "Audience": "ChatMessenger_Client"
  }
}

